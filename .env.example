# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# NEVER commit `.env`, paste the token into code/notebooks, or put it on slides.

# IBM Quantum Platform API key issued for the PINQ2 allocation
PINQ2_TOKEN=

# Optional: instance CRN supplied by the organizers (leave blank otherwise)
PINQ2_INSTANCE=

# Optional: "ibm_cloud" (default) or "ibm_quantum_platform"
QISKIT_CHANNEL=ibm_cloud
